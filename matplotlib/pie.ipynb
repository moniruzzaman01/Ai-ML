    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "students = pd.read_csv('student_data.csv')\n",
    "grouped_students = students.groupby('CompletionStatus').size()\n",
    "plt.pie(grouped_students,labels=grouped_students.index, autopct='%1.2f%%', startangle=90)\n",
    "plt.show()"
   ]
