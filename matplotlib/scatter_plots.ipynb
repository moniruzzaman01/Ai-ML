    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "students = pd.read_csv(\"student_IQdata.csv\")\n",
    "plt.title(\"Study hours vs IQ chart\")\n",
    "plt.xlabel(\"IQ value\")\n",
    "plt.ylabel(\"Study Hours\")\n",
    "plt.scatter(students['Study_Hour'],students['IQ_Score'],color=\"green\")\n"
